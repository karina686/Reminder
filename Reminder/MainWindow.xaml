<Window x:Class="Reminder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Reminder"
        mc:Ignorable="d"
        Title="" Height="400" Width="700">
    <Grid Background="#87CEEB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox Text="  🕐Умная напоминалка" FontSize="50" FontWeight="Bold" Background="#87CEEB" />
        <DataGrid x:Name="lbNames" 
      Grid.Row="1"
      AutoGenerateColumns="False" 
      IsReadOnly="False"
      Margin="10,1,10,32"
      AlternatingRowBackground="#E3F2FD"
      HeadersVisibility="Column" Grid.RowSpan="2">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Часы" Binding="{Binding Hour}" Width="70"/>
                <DataGridTextColumn Header="Минуты" Binding="{Binding Minute}" Width="70"/>
                <DataGridTextColumn Header="Текст" Binding="{Binding Text}" Width="*"/>
                <DataGridCheckBoxColumn Header="Показано" Binding="{Binding IsShown}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2"
    Orientation="Horizontal" 
    HorizontalAlignment="Center" 
    Margin="0,78,0,53" Grid.RowSpan="2">
            <TextBox Width="40" Height="25" Margin="5" x:Name="txtHour"/>
            <TextBox Width="40" Height="25" Margin="5" x:Name="txtMinute"/>
            <TextBox Width="250" Height="25" Margin="5" x:Name="txtText"/>
            <Button Content="Добавить" Click="Add_Click" Width="80" Height="30" Margin="5"  Background="#3CB371"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Height="50"
            Orientation="Horizontal" 
            HorizontalAlignment="Center" 
            Margin="10">
            <Button Content="📂Открыть" Click="Open_Click" Width="80" Height="30" Margin="5" Background="#6495ED"/>
            <Button Content="↓Сохранить" Click="Save_Click" Width="80" Height="30" Margin="5" Background="#4169E1" />
            <Button Content="❌Удалить" Click="Del_Click" Width="80" Height="30" Margin="5" Background="#CD5C5C"/>
        </StackPanel>

    </Grid>
</Window>
